rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 헬퍼 함수 (Helper Functions)
    // ==========================================

    // 로그인된 인증 상태인지 검증
    function isAuthenticated() {
      return request.auth != null;
    }

    // 요청한 유저가 해당 경로의 소유자(userId)와 일치하는지 검증
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 프로필 필드 무결성 검증 (데이터 형식 및 길이 제한)
    function isValidProfileData() {
      let data = request.resource.data;
      return (!('username' in data) || (data.username is string && data.username.size() >= 2 && data.username.size() <= 30)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 200));
    }

    // 링크 필드 무결성 검증
    function isValidLinkData() {
      let data = request.resource.data;
      return (!('title' in data) || (data.title is string && data.title.size() >= 1)) &&
             (!('url' in data) || (data.url is string && data.url.size() >= 1));
    }

    // ==========================================
    // 1. users/{userId} 메인 유저 문서
    // ==========================================
    // - 읽기: 누구나 읽기 가능 (displayName / username 검색 및 공개 페이지 조회)
    // - 쓰기: 로그인 필수, 본인(auth.uid == userId) 데이터만 생성/수정/삭제 가능
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidProfileData();
      allow delete: if isOwner(userId);

      // ==========================================
      // 2. users/{userId}/profile/{profileId} 프로필 서브컬렉션
      // ==========================================
      // - 읽기: 누구나 읽기 가능(로그인 불필요)
      // - 쓰기: 로그인 필수, 로그인한 userId가 경로의 userId와 같아야 함 (본인만 수정)
      match /profile/{profileId} {
        allow read: if true;
        allow create, update: if isOwner(userId) && isValidProfileData();
        allow delete: if isOwner(userId);
      }

      // ==========================================
      // 3. users/{userId}/links/{linkId} 링크 컬렉션
      // ==========================================
      // - 읽기: 누구나 읽기 가능(로그인 불필요)
      // - 쓰기: 로그인 필수, 로그인한 userId가 경로의 userId와 같아야 함 (본인 링크만 등록/수정/삭제)
      match /links/{linkId} {
        allow read: if true;
        allow create: if isOwner(userId) && isValidLinkData();
        // 공개 프로필 방문자는 클릭 수와 서버 기록 시각만 한 번에 1씩 늘릴 수 있습니다.
        // 그 외 링크 내용 변경은 소유자에게만 허용합니다.
        allow update: if (isOwner(userId) && isValidLinkData()) ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['clickCount', '_serverUpdatedAt']) &&
            request.resource.data.clickCount == resource.data.clickCount + 1
          );
        allow delete: if isOwner(userId);
      }
    }

    // ==========================================
    // 4. usernames/{username} 고유 식별자 매핑 컬렉션
    // [보안 강화 추가 규칙]
    // username 중복 방지 및 프로필 검색 시 다른 유저가 타인의 username을 가로채거나 덮어쓰지 못하도록 보호
    // ==========================================
    // - 읽기: 누구나 읽기 가능 (회원가입 및 프로필 수정 시 실시간 중복 체크)
    // - 생성: 로그인된 유저가 본인의 uid로 등록하는 경우만 허용
    // - 수정/삭제: 기존에 해당 username을 점유하고 있던 본인(uid)만 변경/삭제 허용
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
  }
}
